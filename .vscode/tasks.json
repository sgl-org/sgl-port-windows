{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Demo",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "cd demo && build.bat"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
